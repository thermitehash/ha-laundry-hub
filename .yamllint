extends: default
ignore: |
  .esphome/
  **/.esphome/
  node_modules/
  mutants/
rules:
  line-length:
    max: 120
    # Copied verbatim from thermitehash/ha-kroger-restock (only the manifest path changed).
    ignore: |
      .github/workflows/release.yml
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
