# Copy to secrets.yaml (never commit it). In the ESPHome Device Builder use
# the "Secrets" editor instead.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
fallback_ap_password: "change-me-fallback"
# 32-byte base64 key, e.g. from https://esphome.io/components/api.html
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY="
ota_password: "change-me-ota"
